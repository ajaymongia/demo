{
  "name": "personal-loan-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hero FinCorp Personal Loan Assistant: the instant personal loan journey (login to disbursal) as a guided chat, prototype with mock data.",
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
